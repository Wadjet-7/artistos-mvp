{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sitemap-artists.xml",
      "destination": "/api/sitemap-artists"
    },
    {
      "source": "/artist/:id",
      "destination": "/api/artist-page?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app"
    }
  ]
}
